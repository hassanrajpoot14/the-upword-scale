# Public site URL (used for sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL=https://theupwardscale.com

# Web3Forms access key (SERVER ONLY) — https://web3forms.com
# Used by /api/contact and /api/newsletter — never expose to the client.
WEB3FORMS_ACCESS_KEY=

# Legacy client-exposed key (optional fallback only — prefer WEB3FORMS_ACCESS_KEY)
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional contact overrides (shown in footer & /contact)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_PHONE_HREF=
NEXT_PUBLIC_STUDIO_TAGLINE=Remote-First Engineering & Architecture Studio | Serving Clients Globally

# Cal.com scheduling slug (username/event-type) — leave empty to use booking form fallback
NEXT_PUBLIC_CAL_LINK=
# Legacy alias (optional)
NEXT_PUBLIC_CALCOM_LINK=
